# Premarket Hunter — placeholders only. Copy to .env and insert freshly rotated keys.
FMP_API_KEY=
OPENAI_API_KEY=
SEC_USER_AGENT=PremarketHunter/1.0 contact@example.com
DATABASE_URL=sqlite+aiosqlite:////app/data/premarket.db
# For Postgres (Docker/DigitalOcean):
# DATABASE_URL=postgresql+asyncpg://premarket:CHANGE_ME@db:5432/premarket
POSTGRES_DB=premarket
POSTGRES_USER=premarket
POSTGRES_PASSWORD=CHANGE_ME
APP_SECRET=CHANGE_ME
APP_TIMEZONE=America/New_York
OPENAI_MODEL=gpt-4o-mini
FMP_REST_BASE=https://financialmodelingprep.com/stable
SCAN_ENABLED=true
PAPER_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
OPENAI_MONTHLY_BUDGET_USD=25
